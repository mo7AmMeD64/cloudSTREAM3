<?xml version="1.0" encoding="utf-8"?>
<!-- Player control scrim reproduced from mpvKt (https://github.com/mpvKt/mpvKt), GPL-3.0.
     Simplified to a three-stop gradient: mpvKt holds transparency from 20% to 70%. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/md3_player_scrim"
        android:centerColor="@android:color/transparent"
        android:endColor="@color/md3_player_scrim" />
</shape>
