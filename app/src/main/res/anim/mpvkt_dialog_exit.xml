<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Expressive transition: exit the screen, 200ms emphasized accelerate. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate
        android:duration="@integer/md3_player_motion_exit"
        android:fromYDelta="0"
        android:interpolator="@android:interpolator/accelerate_interpolator"
        android:toYDelta="100%" />
    <alpha
        android:duration="@integer/md3_player_motion_exit"
        android:fromAlpha="1"
        android:interpolator="@android:interpolator/accelerate_interpolator"
        android:toAlpha="0" />
</set>
