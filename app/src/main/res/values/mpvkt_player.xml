<?xml version="1.0" encoding="utf-8"?>
<!-- Player control styling. Originally reproduced from mpvKt (GPL-3.0);
     colours and shapes now bind to the Material Design 3 token palette in
     md3_player_tokens.xml (Google I/O 2026 Expressive update). -->
<resources>
    <!-- Stable aliases so existing layouts keep compiling against M3 roles. -->
    <color name="mpvkt_seek_progress">@color/md3_player_primary</color>
    <color name="mpvkt_seek_track">@color/md3_player_surface_container_high</color>
    <color name="mpvkt_button_ripple">@color/md3_player_ripple</color>
    <color name="mpvkt_sheet_surface">@color/md3_player_surface_container_low</color>
    <color name="mpvkt_sheet_button">@color/md3_player_secondary_container</color>

    <!-- M3 filled tonal icon button: 48dp touch target, 24dp icon, full shape. -->
    <style name="MpvKtVideoButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="backgroundTint">@color/md3_player_secondary_container</item>
        <item name="rippleColor">@color/md3_player_ripple</item>
        <item name="android:shadowColor">@color/transparent</item>
        <item name="cornerRadius">@dimen/md3_player_shape_full</item>
        <item name="iconTint">@color/md3_player_on_secondary_container</item>
        <item name="iconSize">24dp</item>
        <item name="textColor">@color/md3_player_on_secondary_container</item>
        <item name="android:textColor">@color/md3_player_on_secondary_container</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">0sp</item>
        <item name="android:layout_marginStart">@dimen/md3_player_space_1</item>
        <item name="android:layout_marginEnd">@dimen/md3_player_space_1</item>
    </style>

    <!-- M3 filled tonal button for the speed sheet, layered on the ported style. -->
    <style name="MpvKtSheetButton" parent="@style/BlackButton">
        <item name="backgroundTint">@color/md3_player_secondary_container</item>
        <item name="textColor">@color/md3_player_on_secondary_container</item>
        <item name="android:textColor">@color/md3_player_on_secondary_container</item>
        <item name="iconTint">@color/md3_player_on_secondary_container</item>
        <item name="rippleColor">@color/md3_player_ripple</item>
        <item name="cornerRadius">@dimen/md3_player_shape_full</item>
    </style>
</resources>
