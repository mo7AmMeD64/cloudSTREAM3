<?xml version="1.0" encoding="utf-8"?>
<!-- Player styling reproduced from mpvKt (https://github.com/mpvKt/mpvKt), GPL-3.0.
     Static dark-scheme values; mpvKt itself follows Material You dynamic color. -->
<resources>
    <color name="mpvkt_seek_progress">#E9B5EE</color>
    <color name="mpvkt_seek_track">#171217</color>
    <color name="mpvkt_button_ripple">#80E9B5EE</color>

    <!-- Bare white icon button: 20dp icon with 14dp padding, circular ripple, no label. -->
    <style name="MpvKtVideoButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/mpvkt_button_ripple</item>
        <item name="android:shadowColor">@color/transparent</item>
        <item name="cornerRadius">24dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconSize">20dp</item>
        <item name="textColor">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">0sp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
    </style>
</resources>
