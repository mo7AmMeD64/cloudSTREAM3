<?xml version="1.0" encoding="utf-8"?>
<!-- Material Design 3 (Google I/O 2026 update) tokens for the player UI.
     MD3 baseline dark palette; the player theme is always dark and edge-to-edge.
     Source: https://m3.material.io/ (design tokens), Apache-2.0 design guidance. -->
<resources>
    <!-- Colour roles: tonal pairings only (on-X is used on X). -->
    <color name="md3_player_primary">#D0BCFF</color>
    <color name="md3_player_on_primary">#381E72</color>
    <color name="md3_player_primary_container">#4F378B</color>
    <color name="md3_player_on_primary_container">#EADDFF</color>
    <color name="md3_player_secondary_container">#4A4458</color>
    <color name="md3_player_on_secondary_container">#E8DEF8</color>
    <color name="md3_player_surface">#141218</color>
    <color name="md3_player_surface_container_low">#1D1B20</color>
    <color name="md3_player_surface_container_high">#2B2930</color>
    <color name="md3_player_on_surface">#E6E0E9</color>
    <color name="md3_player_on_surface_variant">#CAC4D0</color>
    <color name="md3_player_outline_variant">#49454F</color>
    <color name="md3_player_scrim">#99000000</color>
    <color name="md3_player_ripple">#52D0BCFF</color>

    <!-- 8dp spacing system. -->
    <dimen name="md3_player_space_1">8dp</dimen>
    <dimen name="md3_player_space_2">16dp</dimen>
    <dimen name="md3_player_space_3">24dp</dimen>

    <!-- Expressive shape tokens. -->
    <dimen name="md3_player_shape_medium">16dp</dimen>
    <dimen name="md3_player_shape_extra_large">28dp</dimen>
    <dimen name="md3_player_shape_full">9999dp</dimen>

    <!-- Expressive motion tokens: decelerate 400ms, accelerate 200ms. -->
    <integer name="md3_player_motion_enter">400</integer>
    <integer name="md3_player_motion_exit">200</integer>
</resources>
